AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00000367> "sector"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00000367> <http://purl.obolibrary.org/obo/BFO_0000031>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00010412> (creative work licence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00010412> "A creative work licence is a copyright license that determines ownership and permissions for literary work and multimedia work that combines various media types such as text, audio, images, animations, video and interactive content and its collections.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00010412> "creative work licence"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00010412> <https://openenergyplatform.org/ontology/oeo/OEO_00020185>)

